#!/usr/bin/env php
<?php

declare(strict_types=1);

if (file_exists(__DIR__ . '/../vendor/autoload.php')) {
    require_once __DIR__ . '/../vendor/autoload.php';
}

$baseDir = dirname(__DIR__) . '/src';
$categories = ['Creational', 'Structural', 'Behavioral'];

// Helper to find all available patterns
$patterns = [];
$index = 1;

foreach ($categories as $category) {
    $categoryDir = $baseDir . '/' . $category;
    if (!is_dir($categoryDir)) {
        continue;
    }
    
    $dirs = scandir($categoryDir);
    foreach ($dirs as $dir) {
        if ($dir === '.' || $dir === '..' || !is_dir($categoryDir . '/' . $dir)) {
            continue;
        }
        
        $entryFile = null;
        foreach (['index.php', 'main.php', 'app.php', 'Demo.php', 'run.php'] as $entryCandidate) {
            if (file_exists($categoryDir . '/' . $dir . '/' . $entryCandidate)) {
                $entryFile = $categoryDir . '/' . $dir . '/' . $entryCandidate;
                break;
            }
        }
        
        $patterns[] = [
            'id' => $index++,
            'category' => $category,
            'name' => $dir,
            'path' => $category . '/' . $dir,
            'entry' => $entryFile,
        ];
    }
}

$arg = $argv[1] ?? null;

// Case 1: Direct file path provided (e.g. src/Creational/Singleton/index.php)
if ($arg !== null && file_exists($arg)) {
    echo "\033[1;36m=== Running: {$arg} ===\033[0m\n\n";
    require $arg;
    echo "\n\033[2m--------------------------------------------------\033[0m\n";
    exit(0);
}

// Case 2: Pattern name or path provided (e.g. Singleton, Creational/Singleton)
if ($arg !== null) {
    $arg = trim($arg);
    $matched = null;
    
    foreach ($patterns as $p) {
        if (strcasecmp($p['name'], $arg) === 0 || 
            strcasecmp($p['path'], $arg) === 0 || 
            strcasecmp(str_replace('/', '', $p['path']), str_replace('/', '', $arg)) === 0) {
            $matched = $p;
            break;
        }
    }
    
    if ($matched === null) {
        echo "\033[31mPattern or file '{$arg}' not found!\033[0m\n\n";
        echo "Available patterns:\n";
        foreach ($patterns as $p) {
            echo "  - {$p['path']}\n";
        }
        exit(1);
    }
    
    runPattern($matched);
    exit(0);
}

// Case 3: Interactive Menu
echo "\033[2J\033[H"; // Clear terminal screen
echo "\033[1;36m=================================================================\033[0m\n";
echo "\033[1;37m 🚀 Design Patterns Runner - Select a pattern to run\033[0m\n";
echo "\033[1;36m=================================================================\033[0m\n";

$currentCategory = '';
foreach ($patterns as $p) {
    if ($p['category'] !== $currentCategory) {
        $currentCategory = $p['category'];
        echo "\n\033[1;33m--- {$currentCategory} Patterns ---\033[0m\n";
    }
    
    $status = $p['entry'] !== null 
        ? "\033[32m[Ready]\033[0m" 
        : "\033[2m[Empty]\033[0m";
        
    printf("  \033[1;36m%2d)\033[0m %-30s %s\n", $p['id'], $p['name'], $status);
}

echo "\n\033[1mEnter pattern number or name to run (or 'q' to quit): \033[0m";
$input = trim((string)fgets(STDIN));

if ($input === 'q' || $input === 'exit' || $input === '') {
    echo "Exiting.\n";
    exit(0);
}

$selected = null;
if (is_numeric($input)) {
    $num = (int)$input;
    foreach ($patterns as $p) {
        if ($p['id'] === $num) {
            $selected = $p;
            break;
        }
    }
} else {
    foreach ($patterns as $p) {
        if (strcasecmp($p['name'], $input) === 0 || strcasecmp($p['path'], $input) === 0) {
            $selected = $p;
            break;
        }
    }
}

if ($selected === null) {
    echo "\033[31mInvalid selection: '{$input}'\033[0m\n";
    exit(1);
}

runPattern($selected);

function runPattern(array $pattern): void
{
    if ($pattern['entry'] === null) {
        echo "\n\033[33m⚠ No entry file (index.php) found in src/{$pattern['path']}/\033[0m\n";
        echo "\033[34mℹ Create 'src/{$pattern['path']}/index.php' and write your code there.\033[0m\n\n";
        return;
    }
    
    echo "\n\033[1;36m=================================================================\033[0m\n";
    echo "\033[1;33m [ " . strtoupper($pattern['category']) . " ] \033[0m\n";
    echo "\033[1;37m Pattern: \033[32m" . $pattern['name'] . "\033[0m\n";
    echo "\033[1;36m=================================================================\033[0m\n\n";
    
    $startTime = microtime(true);
    require $pattern['entry'];
    $duration = round((microtime(true) - $startTime) * 1000, 2);
    
    echo "\n\n\033[2m---------------------------------------------------------\033[0m\n";
    echo "\033[34mℹ Executed in {$duration} ms | File: src/{$pattern['path']}/" . basename($pattern['entry']) . "\033[0m\n\n";
}
